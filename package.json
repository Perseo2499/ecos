{
  "name": "ecos",
  "version": "3.10.0",
  "description": "Ecos: de tus redes a tu blog",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:ui": "node --test test-ui/*.test.js",
    "test:wp": "node test-wp/run.js",
    "plugin": "node scripts/build-wp-plugin.js",
    "dist": "node scripts/build-wp-plugin.js && electron-builder --win",
    "third-party": "node scripts/third-party.js"
  },
  "devDependencies": {
    "@wordpress/block-library": "^12.2.0",
    "@wordpress/blocks": "^17.2.0",
    "electron": "45.3.2",
    "electron-builder": "^26.18.1",
    "jsdom": "^31.0.1",
    "playwright": "~1.63.0"
  },
  "build": {
    "appId": "com.asociacionelin.redesablog",
    "productName": "Ecos",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "wp-plugin/ecos/ecos.php",
      "package.json"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "artifactName": "Ecos-Setup-${version}.${ext}",
      "shortcutName": "Ecos"
    },
    "portable": {
      "artifactName": "Ecos-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Perseo2499",
        "repo": "ecos",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 Perseo2499. Software libre bajo GPL-3.0-or-later.",
    "asarUnpack": [
      "**/node_modules/@lydell/node-pty*/**",
      "**/node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "build/winhello.exe",
        "to": "winhello.exe"
      },
      {
        "from": "build/ecos-wordpress.zip",
        "to": "ecos-wordpress.zip"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE.txt"
      },
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.18",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.2.0",
    "qrcode": "^1.5.4",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "license": "GPL-3.0-or-later",
  "private": true,
  "author": "Perseo2499",
  "homepage": "https://github.com/Perseo2499/ecos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Perseo2499/ecos.git"
  }
}
