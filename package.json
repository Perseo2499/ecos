{
  "name": "ecos",
  "version": "0.1.0",
  "description": "Convierte publicaciones de Instagram y Facebook en entradas de WordPress.com",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.asociacionelin.redesablog",
    "productName": "Ecos",
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "adm-zip": "^0.5.18",
    "zod": "^4.6.7"
  }
}