{
  "name": "ecos",
  "version": "0.7.1",
  "description": "Ecos: de tus redes a tu blog",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.asociacionelin.redesablog",
    "productName": "Ecos",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "artifactName": "Ecos-Setup-${version}.${ext}",
      "shortcutName": "Ecos"
    },
    "portable": {
      "artifactName": "Ecos-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Perseo2499",
        "repo": "ecos",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 Asociación Elín. Todos los derechos reservados."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "adm-zip": "^0.5.18",
    "electron-updater": "^6.8.11",
    "zod": "^4.6.7"
  },
  "license": "UNLICENSED",
  "private": true,
  "author": "Asociación Elín"
}
