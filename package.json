{
  "name": "ecos",
  "version": "2.4.0",
  "description": "Ecos: de tus redes a tu blog",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.asociacionelin.redesablog",
    "productName": "Ecos",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": true,
      "icon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "package.json"
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "artifactName": "Ecos-Setup-${version}.${ext}",
      "shortcutName": "Ecos"
    },
    "portable": {
      "artifactName": "Ecos-${version}-portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Perseo2499",
        "repo": "ecos",
        "releaseType": "release"
      }
    ],
    "copyright": "Copyright © 2026 Asociación Elín. Todos los derechos reservados.",
    "asarUnpack": [
      "**/node_modules/@lydell/node-pty*/**"
    ],
    "extraResources": [
      {
        "from": "build/winhello.exe",
        "to": "winhello.exe"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.5.18",
    "electron-updater": "^6.8.11",
    "qrcode": "^1.5.4",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "license": "UNLICENSED",
  "private": true,
  "author": "Asociación Elín"
}
